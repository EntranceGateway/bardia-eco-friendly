RewriteEngine On

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"

  <FilesMatch "\.(?:jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:php|html|json)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# ─── Security: block direct access to sensitive files ────────────────────
RewriteRule ^(\.env|composer\.lock|composer\.json)$ - [F,L]
RewriteRule ^vendor/ - [F,L]

# ─── Pass CMS and storage directories through unchanged ────────────────
RewriteCond %{REQUEST_URI} ^/bardiya-eco-friendly/cms/ [OR]
RewriteCond %{REQUEST_URI} ^/bardiya-eco-friendly/storage/
RewriteRule ^ - [L]

# ─── Root directory → index.php (CMS redirect) ────────────────────────
RewriteRule ^$ index.php [L]

# ─── If request is an actual file, serve it directly ───────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ─── Everything else → API router ──────────────────────────────────
RewriteRule ^(.*)$ public/index.php [QSA,L]
